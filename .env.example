# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Key used for client-side note encryption key derivation (never commit real value)
NOTES_ENCRYPTION_PEPPER=

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# --- SmartBill (e-Factura RO) ---
SMARTBILL_USERNAME=
SMARTBILL_TOKEN=
SMARTBILL_CIF=
SMARTBILL_SERIES=
SMARTBILL_WEBHOOK_SECRET=

# --- Twilio / WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
THERAPIST_PHONE=+40xxxxxxxxxx

# --- Cron ---
CRON_SECRET=

# --- App settings ---
NEXT_PUBLIC_THERAPIST_CIF=

# --- Local AI (Ollama) ---
# NEXT_PUBLIC_ prefix required — client fetches Ollama directly from the browser.
# Must remain a LAN/localhost URL — note plaintext must never leave the machine.
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
NEXT_PUBLIC_OLLAMA_MODEL=gemma2:9b-instruct
